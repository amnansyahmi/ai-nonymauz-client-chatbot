# AI-nonymauz backend (OpenAI-compatible). Endpoint will be `${AI_NONYMAUZ_BASE_URL}/chat/completions`.
AI_NONYMAUZ_BASE_URL=https://your-ai-nonymauz-backend.com/v1
AI_NONYMAUZ_API_KEY=your-secret-api-key
AI_NONYMAUZ_MODEL=ai-nonymauz-support
AI_NONYMAUZ_MAX_TOKENS=700

# Client branding
CLIENT_NAME=MajlisMate.ai
CHATBOT_NAME=MajlisMate.ai
SUPPORT_EMAIL=support@example.com

# Default app language: ms | en
NEXT_PUBLIC_DEFAULT_LANGUAGE=ms

# Feature flags
# MajlisMate Live (real-time voice conversation) is on hold and HIDDEN by default.
# Set to true to show the Live voice buttons + sheet.
NEXT_PUBLIC_ENABLE_LIVE_VOICE=false

# Public base URL — used to build ToyyibPay return/callback URLs.
# For local dev this is derived automatically from the request origin.
# NEXT_PUBLIC_BASE_URL=https://majlismate.ai

# ToyyibPay payment gateway.
# Sandbox: https://dev.toyyibpay.com  |  Production: https://toyyibpay.com
# Get your secret key + category code from your ToyyibPay account dashboard.
TOYYIBPAY_BASE_URL=https://toyyibpay.com
TOYYIBPAY_SECRET_KEY=your-toyyibpay-secret-key
TOYYIBPAY_CATEGORY_CODE=your-category-code

# Affiliate login (Auth.js / NextAuth v5).
# AUTH_SECRET: generate with `npx auth secret` (required in production).
AUTH_SECRET=your-auth-secret
# Google OAuth — leave blank to use demo-mode login (mock session, no real OAuth).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Affiliate referral attribution window in days (brief allows 30 / 60 / 90).
AFFILIATE_COOKIE_DAYS=90
