# AI-nonymauz backend (OpenAI-compatible). Endpoint will be `${AI_NONYMAUZ_BASE_URL}/chat/completions`.
AI_NONYMAUZ_BASE_URL=https://your-ai-nonymauz-backend.com/v1
AI_NONYMAUZ_API_KEY=your-secret-api-key
AI_NONYMAUZ_MODEL=ai-nonymauz-support
AI_NONYMAUZ_MAX_TOKENS=700

# Client branding
CLIENT_NAME=MajlisMate.ai
CHATBOT_NAME=MajlisMate.ai
SUPPORT_EMAIL=support@example.com

# Default app language: ms | en
NEXT_PUBLIC_DEFAULT_LANGUAGE=ms

# Feature flags
# MajlisMate Live (real-time voice conversation) is on hold and HIDDEN by default.
# Set to true to show the Live voice buttons + sheet.
NEXT_PUBLIC_ENABLE_LIVE_VOICE=false

# Public base URL — used to build ToyyibPay return/callback URLs.
# For local dev this is derived automatically from the request origin.
# NEXT_PUBLIC_BASE_URL=https://majlismate.ai

# Billplz payment gateway.
# Sandbox: https://www.billplz-sandbox.com  |  Production: https://www.billplz.com
# Get the API secret key + create a Collection in the Billplz dashboard.
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com
BILLPLZ_API_KEY=your-billplz-api-secret-key
BILLPLZ_COLLECTION_ID=your-collection-id
# Optional — X-Signature key for verifying callbacks (we re-verify via API too).
BILLPLZ_X_SIGNATURE_KEY=

# Affiliate login (Auth.js / NextAuth v5).
# AUTH_SECRET: generate with `npx auth secret` (required in production).
AUTH_SECRET=your-auth-secret
# Google OAuth — leave blank to use demo-mode login (mock session, no real OAuth).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link email sign-in for the app (/planner). Uses Resend's HTTP API —
# no extra npm dependency. Leave RESEND_API_KEY blank for dev mode: the sign-in
# link is printed to the SERVER CONSOLE instead of emailed.
# Create an API key + verified sender domain at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=MajlisMate <onboarding@resend.dev>
# AUTH_URL: set in production so magic links point at the correct host.
# AUTH_URL=https://majlismate.ai

# Affiliate referral attribution window in days (brief allows 30 / 60 / 90).
AFFILIATE_COOKIE_DAYS=90

# Admin accounts live in the `admin_user` table (seed a superuser in the DB).
# There is no admin env allowlist — admin login is gated by that table.
